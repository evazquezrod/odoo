<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="sale.ProductTemplateAttributeLine" t-inherit-mode="extension">
        <xpath expr="//div[@name='ptal']" position="attributes">
            <attribute name="t-if">
                this.env.isMainProductConfigurable
                    || this.env.mainProductTmplId !== this.props.productTmplId
            </attribute>
            <attribute name="class" remove="o_input" add="w-100 mb-2" separator=" " />
        </xpath>

        <xpath expr="//div[@name='ptal']/div[1]" position="attributes">
            <attribute name="class" add="d-flex flex-wrap gap-3 align-items-baseline w-100" separator=" " />
        </xpath>

        <xpath expr="//label" position="attributes">
            <attribute name="class" add="fw-bold text-uppercase mb-0 me-2 pt-1" separator=" " />
        </xpath>

        <div name="ptal" position="after">
            <t t-elif="isSelectedPTAVCustom() || this.props.create_variant === 'no_variant'">
                <div t-out="getPtalDisplayName()" class="text-muted small"/>
            </t>
        </div>
    </t>

    <t t-inherit="sale.ptav_select" t-inherit-mode="extension">
        <xpath expr="//select" position="attributes">
            <attribute name="class" add="form-select w-auto flex-grow-1" separator=" " />
        </xpath>
    </t>

    <t t-inherit="sale.ptav_radio" t-inherit-mode="extension">
        <xpath expr="//ul" position="attributes">
            <attribute name="class" add="d-flex flex-wrap gap-3 align-items-center list-unstyled mb-0" separator=" " />
        </xpath>
    </t>

    <t t-inherit="sale.ptav_multi" t-inherit-mode="extension">
        <xpath expr="//ul" position="attributes">
            <attribute name="class" add="d-flex flex-wrap gap-3 align-items-center list-unstyled mb-0" separator=" " />
        </xpath>
    </t>

    <t t-inherit="sale.ptav_pills" t-inherit-mode="extension">
        <xpath expr="//ul" position="attributes">
            <attribute name="class" add="d-flex flex-wrap gap-3 align-items-center list-unstyled mb-0" separator=" " />
        </xpath>
    </t>

    <t t-inherit="sale.ptav_color" t-inherit-mode="extension">
        <xpath expr="//ul" position="attributes">
            <attribute name="class" add="d-flex flex-wrap gap-3 align-items-center list-unstyled mb-0" separator=" " />
        </xpath>
    </t>
</templates>
