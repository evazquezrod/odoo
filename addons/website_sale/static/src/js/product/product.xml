<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="sale.Product" t-inherit-mode="extension">

        <QuantityButtons position="attributes">
            <attribute name="t-if" add="this.props.can_be_sold" separator=" &amp;&amp; " />
        </QuantityButtons>
        <QuantityButtons position="after">
            <t t-call="website_sale.not_for_sale" />
        </QuantityButtons>
        <button name="sale_product_configurator_add_button" position="attributes">
            <attribute name="t-if">this.props.can_be_sold</attribute>
            <attribute name="class" remove="btn-secondary" add="btn-primary" separator=" " />
        </button>
        <xpath expr="//button[@name='sale_product_configurator_add_button']/*[hasclass('fa-plus')]" position="attributes">
            <attribute name="class" remove="fa-plus" add="fa-shopping-cart" separator=" " />
        </xpath>
        <xpath expr="//button[@name='sale_product_configurator_add_button']" position="replace">
                <button name="sale_product_configurator_add_button" t-if="this.props.can_be_sold" class="btn btn-primary mt-2" t-on-click="() => this.env.addProduct(this.props.product_tmpl_id)" t-att-disabled="this.props.adding">
                    <i class="fa fa-shopping-cart me-1" />
                    Add to cart
                </button>
                <t t-if="this.props.optional">
                    <button type="button" class="btn btn-link p-0 o_add_wishlist text-muted small" data-action="o_wishlist" t-att-data-product-template-id="this.props.productTemplateId" t-att-data-product-product-id="this.props.productId" title="Add to Wishlist">
                        <i class="fa fa-heart-o me-2" />
                        <span>Add to wishlist</span>
                    </button>
                </t>
        </xpath>
        <t name="sale_product_configurator_price" position="before">
            <t t-call="website_sale.strikethrough_product_price" />
        </t>
        <xpath expr="//div[@name='o_sale_product_configurator_name']//span[hasclass('h5')]" position="attributes">
            <attribute name="class" remove="h5" add="h6" separator=" " />
        </xpath>
    </t>
    <t t-inherit="sale.product_price" t-inherit-mode="extension">
        <span name="sale_product_configurator_formatted_price" position="attributes">
            <attribute name="class" remove="h5" add="h6" separator=" " />
        </span>
    </t>
    <t t-name="website_sale.not_for_sale">
        <div t-if="!this.props.can_be_sold" class="text-muted fst-italic">
            <i class="fa fa-times me-1" />
            Not available for sale
        </div>
    </t>
    <t t-name="website_sale.strikethrough_product_price">
        <h5 class="oe_striked_price text-muted small" t-if="this.props.strikethrough_price" t-out="formattedStrikethroughPrice" />
    </t>
</templates>
