<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr.KanbanRenderer" t-inherit="web.KanbanRenderer">
        <t t-as="groupOrRecord" position="before">
            <t t-if="showOnboarding">
                <HrActionOnboarding />
            </t>
            <t t-elif="showNoContentHelper">
                <HrActionHelper
                    noContentTitle.translate="Create an employee."
                    noContentParagraph.translate="Find all the information on employees."
                />
            </t>
        </t>
    </t>
</odoo>
