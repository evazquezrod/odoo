<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr.EmployeeActionOnboarding">
        <div class="o_view_nocontent user-select-none">
            <div class="o_nocontent_help">
                <p class="o_hr_onboarding_title text-center">
                    Ready to <span style="text-decoration: underline; text-decoration-color: rgb(0, 217, 255);">start</span> your <span style="text-decoration: underline; text-decoration-color: rgb(219, 226, 116);">experience?</span>
                </p>
                <div>
                    <!-- Buttons -->
                    <div class="px-2 py-2">
                        <div class="row justify-content-center g-2">
                            <div class="col-12 col-md-3">
                                <a class="btn btn-primary w-100 text-nowrap"
                                    style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                    t-on-click="() => this.loadEmployeeScenario()">
                                    Load sample data
                                </a>
                            </div>
                            <div class="col-12 col-md-3">
                                <a class="btn btn-secondary w-100 text-nowrap"
                                    style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                    t-on-click="() => this.actionCreateEmployee()">
                                    Start from scratch
                                </a>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4"/>

                    <div class="container mb-3">
                        <div class="row text-center">
                            <div class="col-12 col-sm-4 mb-2">
                                <p class="o_hr_onboarding_type mb-0">Hiring</p>
                            </div>
                            <div class="col-12 col-sm-4 mb-2">
                                <p class="o_hr_onboarding_type mb-0">Experience</p>
                            </div>
                            <div class="col-12 col-sm-4 mb-2">
                                <p class="o_hr_onboarding_type mb-0">Development</p>
                            </div>
                        </div>
                    </div>

                    <div class="container mt-4 d-none d-md-block">
                        <div class="row text-center">
                            <!-- Hiring -->
                            <div class="col-md-4 d-flex flex-column align-items-center gap-3 mb-3">
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_recruitment/static/description/icon.png" width="56"/>
                                    <small>Hiring</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/sign/static/description/icon.png" width="56"/>
                                    <small>eSign</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_referral/static/description/icon.png" width="56"/>
                                    <small>Referrals</small>
                                </div>
                            </div>

                            <!-- Experience -->
                            <div class="col-md-4 d-flex flex-wrap justify-content-center gap-3 mb-4">
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/ai/static/description/icon.png" width="56"/>
                                    <small>AI</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_payroll/static/description/icon.png" width="56"/>
                                    <small>Payroll</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/planning/static/description/icon.png" width="56"/>
                                    <small>Planning</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_holidays/static/description/icon.png" width="56"/>
                                    <small>Leaves</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/fleet/static/description/icon.png" width="56"/>
                                    <small>Fleet</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/lunch/static/description/icon.png" width="56"/>
                                    <small>Lunch</small>
                                </div>
                            </div>

                            <!-- Development -->
                            <div class="col-md-4 d-flex flex-wrap justify-content-center gap-3 mb-4">
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_appraisal/static/description/icon.png" width="56"/>
                                    <small>Performance</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/hr_skills/static/description/icon.png" width="56"/>
                                    <small>Talent</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/website_slides/static/description/icon.png" width="56"/>
                                    <small>eLearning</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/event/static/description/icon.png" width="56"/>
                                    <small>Trainings</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/documents/static/description/icon.png" width="56"/>
                                    <small>Documents</small>
                                </div>
                                <div class="d-flex flex-column align-items-center o_hr_onboarding_icon">
                                    <img src="/board/static/description/icon.png" width="56"/>
                                    <small>Dashboard</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
