<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr.ListRenderer" t-inherit="web.ListRenderer">
        <t t-call="web.ActionHelper" position="replace">
            <t t-if="showOnboarding">
                <HrActionOnboarding />
            </t>
            <!-- <t t-elif="!model.hasData() or model.useSampleModel and props.info.noContentHelp"> -->
            <t t-elif="showNoContentHelper">
                <HrActionHelper
                    noContentTitle.translate="Create an employee."
                    noContentParagraph.translate="Find all the information on employees."
                />
            </t>
        </t>
    </t>
</odoo>
