<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template
        id="sale_order_portal_template"
        inherit_id="sale.sale_order_portal_template"
    >
        <div name="download_pdf" position="after">
            <t t-if="sale_order.with_user(request.env.user).sudo()._display_return_button()">
                <button
                    class="btn btn-light o_wsale_return_button"
                    t-att-data-sale-order-id="sale_order.id"
                >
                    Return
                </button>
            </t>
        </div>
    </template>
</odoo>
