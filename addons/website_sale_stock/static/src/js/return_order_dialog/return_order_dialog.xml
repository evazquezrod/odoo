<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale.ReturnOrderDialog">
        <Dialog size="size" title="title" contentClass="'o_wsale_return_order_dialog'">
            <table id="o_wsale_reorder_table" class="table table-sm oe_website_sale">
                <thead class="bg-100">
                    <tr id="o_wsale_reorder_header">
                        <th class="text-start td-img">Product</th>
                        <!-- Product name + description -->
                        <th/>
                        <!-- Product Quantity Selector -->
                        <th class="text-center td-qty">Quantity</th>
                        <!-- Product price (per unit) -->
                        <th class="text-end td-price">Price</th>
                    </tr>
                </thead>
                <tbody id="o_wsale_reorder_body" class="sale_tbody">
                    <t t-foreach="this.state.products" t-as="product" t-key="product_index">
                        <tr class="js_product">
                            <td t-if="product.has_image" class="td-img">
                                <img class="product_detail_img" t-att-alt="product.name" t-attf-src="/web/image/product.product/{{product.product_id}}/image_128"/>
                            </td>
                            <td t-att-colspan="product.has_image ? '1' : '2'">
                                <h5><t t-esc="product.name"/></h5>
                                <span class="text-muted d-none d-md-inline-block" t-if="product.description_sale" t-out="product.description_sale"/>
                                <ul
                                    t-if="product.selected_combo_items.length"
                                    class="list-unstyled mb-0 small text-muted mt-1"
                                >
                                    <t
                                        t-foreach="product.selected_combo_items"
                                        t-as="comboItem"
                                        t-key="comboItem.combo_item_id"
                                    >
                                        <li>
                                            <t t-esc="product.quantity"/> x <t t-esc="comboItem.combinationInfo.display_name"/>
                                        </li>
                                    </t>
                                </ul>
                            </td>
                            <td class="text-center td-qty">
                                <QuantityButtons
                                    quantity="product.quantity"
                                    setQuantity="quantity => this.setQuantity(product, quantity)"
                                    isMinusButtonDisabled="product.quantity === 0"
                                    isPlusButtonDisabled="product.quantity == product.ordered_qty"

                                />
                            </td>
                            <td class="text-end td-price">
                                <span t-esc="formatCurrency(product.combinationInfo.price, content.currency)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <t t-set-slot="footer">
                <div class="w-100 d-flex gap-2">
                    <select name="return_reason" class="form-select" required="required">
                        <option value="" disabled="disabled" selected="selected">Select a return reason...</option>
                        <t t-foreach="content.reasons" t-as="reason" t-key="reason.id">
                            <option t-att-value="reason.id" t-out="reason.name"/>
                        </t>
                    </select>
                    <button
                        name="continue"
                        class="btn btn-primary"
                        t-on-click="onContinue"
                    >
                        Continue
                    </button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
