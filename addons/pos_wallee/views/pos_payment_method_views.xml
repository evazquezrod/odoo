<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos.wallee</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="wallee_userid" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee'"/>
                <field name="wallee_spaceid" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee'"/>
                <field name="wallee_auth_key" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee'"/>
                <field name="wallee_terminalid" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee' and not wallee_terminal_identifier"/>
                <field name="wallee_terminal_identifier" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee' and not wallee_terminalid"/>
                <field name="wallee_test_mode" invisible="use_payment_terminal != 'wallee'" required="use_payment_terminal == 'wallee'"/>
            </xpath>
        </field>
    </record>
</odoo>
