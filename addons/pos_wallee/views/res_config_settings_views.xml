<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.wallee</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="inside">
                <setting string="Wallee" help="Accept payments with a Wallee payment terminal"
                    title="The transactions are processed by Wallee. Set your Wallee credentials on the related payment method.">
                    <field name="module_pos_wallee"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
