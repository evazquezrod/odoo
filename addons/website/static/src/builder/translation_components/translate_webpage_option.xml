<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.TranslateWebpageOption">
    <BuilderContext preview="false">
        <t t-if="translationState.isLoading">
            <i class="fa fa-circle-o-notch fa-spin me-2"/><b>Translating...</b>
        </t>
        <t t-else="">
            <BuilderRow label.translate="Translate to"
                tooltip.translate="Translate the whole content with AI">
                <BuilderButton action="'translateWebpageAI'">
                    <t t-esc="state.language"/>
                </BuilderButton>
            </BuilderRow>
        </t>
    </BuilderContext>
</t>

</templates>
