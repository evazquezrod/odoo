<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.epson.printer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_other_devices']" position="after">
                <setting id="pos_network_printer" string="Network Printer" help="Connect device to your PoS without an IoT Box">
                    <field name="pos_network_printer" />
                    <div class="content-group" invisible="not pos_network_printer">
                        <div class="row">
                            <field name="pos_nw_printer_ip" invisible="not pos_network_printer" placeholder="POS Printer Receipt Printer IP Address" />
                        </div>
                        <div class="row">
                            <field name="pos_device_ip" invisible="not pos_network_printer" placeholder="Device IP Address" />
                        </div>
                        <div class="row" invisible="pos_nw_printer_ip in [False, '']">
                            <label string="Cashdrawer" for="pos_iface_cashdrawer" class="col-lg-3 o_light_label"/>
                            <field name="pos_iface_cashdrawer"/>
                        </div>
                    </div>
                    <div role="alert" class="alert alert-warning" invisible="not pos_iface_print_via_proxy or not pos_network_printer or pos_nw_printer_ip in [False, '']">
                        The receipt printer will be used instead of the receipt printer connected to the IoT Box.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
