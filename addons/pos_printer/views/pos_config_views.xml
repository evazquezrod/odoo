<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_iot_config_view_form" model="ir.ui.view">
        <field name="name">pos.iot.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="pos_network_printer" string="Network Printer" help="Connect device to your PoS without an IoT Box">
                    <field name="network_printer" />
                    <div class="content-group" invisible="not network_printer">
                        <div class="row">
                            <field name="nw_printer_ip" invisible="not network_printer" placeholder="POS Printer Receipt Printer IP Address" />
                        </div>
                        <div class="row">
                            <field name="device_ip" invisible="not network_printer" placeholder="Device IP Address" />
                        </div>
                        <div class="row" invisible="nw_printer_ip in [False, '']">
                            <label string="Cashdrawer" for="iface_cashdrawer" class="col-lg-3 o_light_label"/>
                            <field name="iface_cashdrawer"/>
                        </div>
                    </div>
                    <div role="alert" class="alert alert-warning" invisible="not iface_print_via_proxy or not network_printer or nw_printer_ip in [False, '']">
                        The receipt printer will be used instead of the receipt printer connected to the IoT Box.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
